import java.util.Locale

enum class Mode { Animation, Paint }

@Composable
fun HomeScreen(
    onOpen: (Mode, String) -> Unit,
    vm: HomeViewModel = viewModel(),
) {
    LaunchedEffect(Unit) { vm.refresh() }

    val dark = isSystemInDarkTheme()
    val bgColors = if (dark)
        listOf(Color(0xFF0B1020), Color(0xFF111A34))
    else
        listOf(Color(0xFFF8FAFC), Color(0xFFEEF2F7))

    var showNewDialog by remember { mutableStateOf(false) }
    var renameTarget by remember { mutableStateOf<ProjectStore.Summary?>(null) }
    var deleteTarget by remember { mutableStateOf<ProjectStore.Summary?>(null) }

    Box(
        Modifier
            .fillMaxSize()
            .background(ComposeBrush.verticalGradient(bgColors)),
    ) {
        Column(
            Modifier
                .fillMaxSize()
                .statusBarsPadding()
                .navigationBarsPadding(),
        ) {
            Column(
                Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 28.dp, vertical = 24.dp)
            ) {
                Text(
                    "AnimY",
                    fontSize = 40.sp,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onBackground,
                    letterSpacing = (-1).sp,
                )
                Spacer(Modifier.height(4.dp))
                Text(
                    if (vm.projects.isEmpty()) "开始你的第一个作品"
                    else "共 ${vm.projects.size} 个作品",
                    fontSize = 14.sp,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
            }

            Box(Modifier.weight(1f)) {
                if (vm.loading) {
                    Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                        Text("加载中…", color = MaterialTheme.colorScheme.onSurfaceVariant)
                    }
                } else if (vm.projects.isEmpty()) {
                    EmptyState()
                } else {
                    LazyColumn(
                        Modifier.fillMaxSize(),
                        contentPadding = PaddingValues(
                            start = 20.dp, end = 20.dp, top = 4.dp, bottom = 100.dp
                        ),
                        verticalArrangement = Arrangement.spacedBy(12.dp),
                    ) {
                        items(vm.projects, key = { it.id }) { p ->
                            ProjectCard(
                                summary = p,
                                onClick = { onOpen(modeOf(p.mode), p.id) },
                                onRename = { renameTarget = p },
                                onDelete = { deleteTarget = p },
                            )
                        }
                    }
                }
            }
        }

        Box(
            Modifier
                .align(Alignment.BottomEnd)
                .padding(24.dp)
                .size(64.dp)
                .clip(CircleShape)
                .background(MaterialTheme.colorScheme.primary)
                .clickable { showNewDialog = true },
            contentAlignment = Alignment.Center,
        ) {
            PlusIcon(Color.White, s = 28.dp)
        }
    }

    if (showNewDialog) {
        NewProjectDialog(
            onDismiss = { showNewDialog = false },
            onConfirm = { mode, name, preset ->
                showNewDialog = false
                val id = vm.createProject(mode, name, preset)
                onOpen(mode, id)
            },
        )
    }

    renameTarget?.let { p ->
        RenameDialog(
            initial = p.name,
            onDismiss = { renameTarget = null },
            onConfirm = { newName ->
                vm.rename(p.id, newName)
                renameTarget = null
            },
        )
    }

    deleteTarget?.let { p ->
        AlertDialog(
            onDismissRequest = { deleteTarget = null },
            title = { Text("删除作品") },
            text = { Text("「${p.name}」将被永久删除，无法恢复。") },
            confirmButton = {
                TextButton(onClick = {
                    vm.delete(p.id)
                    deleteTarget = null
                }) { Text("删除", color = MaterialTheme.colorScheme.error) }
            },
            dismissButton = {
                TextButton(onClick = { deleteTarget = null }) { Text("取消") }
            },
        )
    }
}

private fun modeOf(m: ProjectMode): Mode = when (m) {
    ProjectMode.Animation -> Mode.Animation
    ProjectMode.Paint -> Mode.Paint
}

@Composable
private fun EmptyState() {
    Column(
        Modifier.fillMaxSize(),
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally,
    ) {
        Text("🎨", fontSize = 56.sp)
        Spacer(Modifier.height(16.dp))
        Text(
            "还没有作品",
            fontSize = 18.sp,
            fontWeight = FontWeight.Medium,
            color = MaterialTheme.colorScheme.onSurface,
        )
        Spacer(Modifier.height(6.dp))
        Text(
            "点击右下角 + 开始",
            fontSize = 14.sp,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
        )
    }
}

@Composable
private fun ProjectCard(
    summary: ProjectStore.Summary,
    onClick: () -> Unit,
    onRename: () -> Unit,
    onDelete: () -> Unit,
) {
    var menuOpen by remember { mutableStateOf(false) }

    Card(
        shape = RoundedCornerShape(20.dp),
        colors = CardDefaults.cardColors(
            containerColor = MaterialTheme.colorScheme.surface,
        ),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
        modifier = Modifier
            .fillMaxWidth()
            .clickable(onClick = onClick),
    ) {
        Row(
            Modifier.padding(12.dp),
            verticalAlignment = Alignment.CenterVertically,
        ) {
            Box(
                Modifier
                    .size(64.dp)
                    .clip(RoundedCornerShape(14.dp))
                    .background(
                        ComposeBrush.linearGradient(
                            listOf(Color(0xFF4F46E5), Color(0xFF7C3AED))
                        )
                    ),
                contentAlignment = Alignment.Center,
            ) {
                val bitmapState = produceState<ImageBitmap?>(
                    initialValue = null,
                    summary.thumbPath, summary.updatedAt,
                ) {
                    value = withContext(Dispatchers.IO) {
                        summary.thumbPath?.let { path ->
                            runCatching {
                                BitmapFactory.decodeFile(path)?.asImageBitmap()
                            }.getOrNull()
                        }
                    }
                }
                val bitmap = bitmapState.value
                if (bitmap != null) {
                    Image(
                        bitmap = bitmap,
                        contentDescription = null,
                        contentScale = ContentScale.Crop,
                        modifier = Modifier.fillMaxSize(),
                    )
                } else {
                    Text(
                        if (summary.mode == ProjectMode.Animation) "🎬" else "🎨",
                        fontSize = 28.sp,
                    )
                }
            }

            Spacer(Modifier.width(14.dp))

            Column(Modifier.weight(1f)) {
                Text(
                    summary.name,
                    fontSize = 16.sp,
                    fontWeight = FontWeight.SemiBold,
                    color = MaterialTheme.colorScheme.onSurface,
                )
                Spacer(Modifier.height(4.dp))
                Text(
                    buildString {
                        append(if (summary.mode == ProjectMode.Animation) "动画" else "绘画")
                        append("  ·  ")
                        if (summary.mode == ProjectMode.Animation) {
                            append("${summary.frameCount} 帧  ·  ")
                        }
                        append(formatTime(summary.updatedAt))
                    },
                    fontSize = 12.sp,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
            }

            Box {
                Box(
                    Modifier
                        .size(36.dp)
                        .clip(CircleShape)
                        .clickable { menuOpen = true },
                    contentAlignment = Alignment.Center,
                ) {
                    Text(
                        "⋮",
                        fontSize = 18.sp,
                        color = MaterialTheme.colorScheme.onSurfaceVariant,
                    )
                }
                DropdownMenu(
                    expanded = menuOpen,
                    onDismissRequest = { menuOpen = false },
                ) {
                    DropdownMenuItem(
                        text = { Text("重命名") },
                        onClick = {
                            menuOpen = false
                            onRename()
                        },
                    )
                    DropdownMenuItem(
                        text = {
                            Text("删除", color = MaterialTheme.colorScheme.error)
                        },
                        onClick = {
                            menuOpen = false
                            onDelete()
                        },
                    )
                }
            }
        }
    }
}

@Composable
private fun RenameDialog(
    initial: String,
    onDismiss: () -> Unit,
    onConfirm: (String) -> Unit,
) {
    var text by remember { mutableStateOf(initial) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("重命名") },
        text = {
            Box(
                Modifier
                    .fillMaxWidth()
                    .clip(RoundedCornerShape(12.dp))
                    .background(MaterialTheme.colorScheme.surfaceVariant)
                    .padding(horizontal = 14.dp, vertical = 12.dp),
            ) {
                BasicTextField(
                    value = text,
                    onValueChange = { if (it.length <= 40) text = it },
                    singleLine = true,
                    textStyle = MaterialTheme.typography.bodyMedium.copy(
                        color = MaterialTheme.colorScheme.onSurface,
                    ),
                    cursorBrush = SolidColor(MaterialTheme.colorScheme.primary),
                    modifier = Modifier.fillMaxWidth(),
                )
                if (text.isEmpty()) {
                    Text(
                        "输入名称",
                        color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.5f),
                    )
                }
            }
        },
        confirmButton = {
            TextButton(
                onClick = { onConfirm(text) },
                enabled = text.isNotBlank(),
            ) { Text("确定") }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("取消") }
        },
    )
}

@Composable
private fun NewProjectDialog(
    onDismiss: () -> Unit,
    onConfirm: (Mode, String, CanvasPreset) -> Unit,
) {
    var name by remember { mutableStateOf("") }
    var mode by remember { mutableStateOf(Mode.Animation) }
    var preset by remember { mutableStateOf(CanvasPreset.Square) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("新建作品") },
        text = {
            Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {

                // ─── 名称 ───
                Text(
                    "名称",
                    fontSize = 13.sp,
                    fontWeight = FontWeight.Medium,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
                Box(
                    Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(12.dp))
                        .background(MaterialTheme.colorScheme.surfaceVariant)
                        .padding(horizontal = 14.dp, vertical = 12.dp),
                ) {
                    BasicTextField(
                        value = name,
                        onValueChange = { if (it.length <= 40) name = it },
                        singleLine = true,
                        textStyle = MaterialTheme.typography.bodyMedium.copy(
                            color = MaterialTheme.colorScheme.onSurface,
                        ),
                        cursorBrush = SolidColor(MaterialTheme.colorScheme.primary),
                        modifier = Modifier.fillMaxWidth(),
                    )
                    if (name.isEmpty()) {
                        Text(
                            "输入名称（可留空）",
                            color = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.5f),
                        )
                    }
                }

                // ─── 模式 ───
                Text(
                    "模式",
                    fontSize = 13.sp,
                    fontWeight = FontWeight.Medium,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    ModeChip(
                        glyph = "🎬",
                        title = "帧动画",
                        selected = mode == Mode.Animation,
                        onClick = { mode = Mode.Animation },
                        modifier = Modifier.weight(1f),
                    )
                    ModeChip(
                        glyph = "🎨",
                        title = "绘画",
                        selected = mode == Mode.Paint,
                        onClick = { mode = Mode.Paint },
                        modifier = Modifier.weight(1f),
                    )
                }

                // ─── 画布尺寸 ───
                Text(
                    "画布尺寸",
                    fontSize = 13.sp,
                    fontWeight = FontWeight.Medium,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
                Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
                    CanvasPreset.entries.forEach { p ->
                        PresetRow(
                            preset = p,
                            selected = preset == p,
                            onClick = { preset = p },
                        )
                    }
                }
            }
        },
        confirmButton = {
            TextButton(
                onClick = { onConfirm(mode, name, preset) },
            ) { Text("创建") }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("取消") }
        },
    )
}

@Composable
private fun ModeChip(
    glyph: String,
    title: String,
    selected: Boolean,
    onClick: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Row(
        modifier
            .clip(RoundedCornerShape(12.dp))
            .background(
                if (selected) MaterialTheme.colorScheme.primary.copy(alpha = 0.12f)
                else MaterialTheme.colorScheme.surfaceVariant
            )
            .border(
                width = if (selected) 1.5.dp else 0.dp,
                color = if (selected) MaterialTheme.colorScheme.primary
                else Color.Transparent,
                shape = RoundedCornerShape(12.dp),
            )
            .clickable(onClick = onClick)
            .padding(horizontal = 12.dp, vertical = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        Text(glyph, fontSize = 20.sp)
        Spacer(Modifier.width(8.dp))
        Text(
            title,
            fontSize = 14.sp,
            fontWeight = if (selected) FontWeight.SemiBold else FontWeight.Normal,
            color = if (selected) MaterialTheme.colorScheme.primary
            else MaterialTheme.colorScheme.onSurface,
        )
    }
}

@Composable
private fun PresetRow(
    preset: CanvasPreset,
    selected: Boolean,
    onClick: () -> Unit,
) {
    Row(
        Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(10.dp))
            .background(
                if (selected) MaterialTheme.colorScheme.primary.copy(alpha = 0.10f)
                else Color.Transparent
            )
            .clickable(onClick = onClick)
            .padding(horizontal = 12.dp, vertical = 10.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        // 比例预览（保持宽高比的小矩形）
        Box(
            Modifier.size(28.dp),
            contentAlignment = Alignment.Center,
        ) {
            val aspect = preset.size.width.toFloat() / preset.size.height
            Canvas(Modifier.fillMaxSize()) {
                val maxW = size.width
                val maxH = size.height
                val w = if (aspect >= 1f) maxW else maxH * aspect
                val h = if (aspect >= 1f) maxW / aspect else maxH
                val l = (maxW - w) / 2f
                val t = (maxH - h) / 2f
                drawRect(
                    color = if (selected) Color(0xFF4F46E5)
                    else Color(0xFF94A3B8),
                    topLeft = Offset(l, t),
                    size = Size(w, h),
                    style = Stroke(width = 2f),
                )
            }
        }
        Spacer(Modifier.width(12.dp))
        Text(
            preset.label,
            fontSize = 14.sp,
            fontWeight = if (selected) FontWeight.SemiBold else FontWeight.Normal,
            color = if (selected) MaterialTheme.colorScheme.primary
            else MaterialTheme.colorScheme.onSurface,
        )
    }
}

private fun formatTime(ms: Long): String {
    val diff = System.currentTimeMillis() - ms
    return when {
        diff < 60_000 -> "刚刚"
        diff < 3_600_000 -> "${diff / 60_000} 分钟前"
        diff < 86_400_000 -> "${diff / 3_600_000} 小时前"
        diff < 2_592_000_000L -> "${diff / 86_400_000} 天前"
        else -> SimpleDateFormat("M月d日", Locale.getDefault()).format(Date(ms))
    }
}
