private const val SAVE_DEBOUNCE_MS = 800L

class EditorViewModel(
    app: Application,
    private val projectId: String,
) : AndroidViewModel(app) {

    private val repository = ProjectRepository(app)
    private val history = HistoryManager()
    val renderCache = RenderCache()

    private val _state = MutableStateFlow(EditorState())
    val state: StateFlow<EditorState> = _state.asStateFlow()

    val liveStroke = mutableStateListOf<StrokePoint>()
    val draftSelectionPath = mutableStateListOf<Offset>()

    private var saveJob: Job? = null
    /** 取色提示自动消失的 Job。每次取色 cancel 旧的、起新的。 */
    private var colorDismissJob: Job? = null
    private var transformSnapshot: ElementTransform? = null
    private var transformElementId: Long? = null

    private var liquifyPixels: IntArray? = null
    private var liquifyBitmap: Bitmap? = null
    private var liquifyLastPoint: Offset? = null

    init {
        viewModelScope.launch { load() }
    }
    // region Lifecycle

    // ═══════════════════════════════════════════════
    //  加载
    // ═══════════════════════════════════════════════

    private suspend fun load() {
        val loaded = runCatching { repository.load(projectId) }.getOrNull()
        val project = loaded ?: Project(
            name = "Untitled",
            mode = ProjectMode.Animation,
            canvasSize = IntSize(1080, 1080),
        )
        if (loaded == null) runCatching { repository.save(project, projectId) }
        _state.update {
            it.copy(
                project = project,
                currentFrameIndex = 0,
                currentLayerIndex = 0,
                isLoading = false,
            )
        }
    }
    // endregion

    // region EventDispatch

    // ═══════════════════════════════════════════════
    //  事件分发
    // ═══════════════════════════════════════════════

    fun onIntent(intent: EditorIntent) {
        when (intent) {
            is EditorIntent.StrokeStart -> startStroke(intent)
            is EditorIntent.StrokeMove -> moveStroke(intent)
            EditorIntent.StrokeEnd -> endStroke()
            EditorIntent.StrokeCancel -> cancelStroke()

            is EditorIntent.PickColor -> pickColor(intent.point)
            EditorIntent.DismissPickedColor ->
                _state.update { it.copy(lastPickedColor = null) }

            is EditorIntent.SelectionTap -> selectionTap(intent.point)
            is EditorIntent.SelectionDraftStart -> selectionDraftStart(intent.point)
            is EditorIntent.SelectionDraftMove -> selectionDraftMove(intent.point)
            EditorIntent.SelectionDraftEnd -> selectionDraftEnd()

            EditorIntent.SelectionCommit -> commitFloating()
            EditorIntent.SelectionFill -> fillFloating()
            EditorIntent.SelectionDelete -> deleteSelection()
            EditorIntent.SelectionClear -> clearFloating()
            EditorIntent.SelectionCancel -> cancelFloating()

            is EditorIntent.SetShapeTool ->
                _state.update { it.copy(shapeTool = intent.tool, activeTool = ActiveTool.Shape) }
            is EditorIntent.SetShapeFilled ->
                _state.update { it.copy(shapeFilled = intent.filled) }
            is EditorIntent.ShapeDraftStart -> shapeDraftStart(intent.point)
            is EditorIntent.ShapeDraftMove -> shapeDraftMove(intent.point)
            EditorIntent.ShapeDraftEnd -> shapeDraftEnd()
            EditorIntent.ShapeConfirm -> confirmShape()
            EditorIntent.ShapeCancel -> cancelShape()
            EditorIntent.ShapeConfirm -> confirmShape()
            EditorIntent.ShapeCancel -> cancelShape()

            is EditorIntent.SetTool -> setTool(intent.tool)
            is EditorIntent.SetSelectTool -> setSelectTool(intent.tool)
            is EditorIntent.SetBrushType -> setBrushType(intent.type)
            is EditorIntent.SetColor -> setColor(intent.color)
            is EditorIntent.SetBrushSize -> setBrushSize(intent.size)

            EditorIntent.Undo -> undo()
            EditorIntent.Redo -> redo()

            is EditorIntent.SelectFrame -> selectFrame(intent.index)
            EditorIntent.AddFrame -> addFrame()
            is EditorIntent.DuplicateFrame -> duplicateFrame(intent.index)
            is EditorIntent.DeleteFrame -> deleteFrame(intent.index)
            is EditorIntent.MoveFrame -> moveFrame(intent.from, intent.to)
            is EditorIntent.SetFrameDuration -> setFrameDuration(intent.index, intent.ms)
            EditorIntent.NextFrame -> nextFrame()
            EditorIntent.TogglePlay -> togglePlay()
            EditorIntent.ToggleOnion -> toggleOnion()
            is EditorIntent.SetOnionConfig -> setOnionConfig(intent.prev, intent.next)
            EditorIntent.ToggleGrid -> toggleGrid()

            is EditorIntent.SelectLayer -> selectLayer(intent.index)
            is EditorIntent.AddLayer -> addLayer(intent.name)
            is EditorIntent.DeleteLayer -> deleteLayer(intent.index)
            is EditorIntent.ToggleLayerVisible -> toggleLayerVisible(intent.index)
            is EditorIntent.SetLayerAlpha -> setLayerAlpha(intent.index, intent.alpha)
            is EditorIntent.RenameLayer -> renameLayer(intent.index, intent.name)
            is EditorIntent.MergeDown -> mergeDown(intent.layerIndex)
            is EditorIntent.MoveLayer -> moveLayer(intent.from, intent.to)
            is EditorIntent.MoveLayerUp -> moveLayerUp(intent.index)
            is EditorIntent.MoveLayerDown -> moveLayerDown(intent.index)

            is EditorIntent.SelectElementAt -> selectElementAt(intent.point)
            EditorIntent.DeselectElement -> deselectElement()
            is EditorIntent.TransformStart -> transformStart(intent.elementId)
            is EditorIntent.ElementDragDelta -> elementDragDelta(intent.delta)
            is EditorIntent.ElementTransformDelta -> elementTransformDelta(intent)
            EditorIntent.TransformEnd -> transformEnd()

            is EditorIntent.SetBackground -> setBackground(intent.color)
            is EditorIntent.ImportImage -> importImage(intent.uri)

            is EditorIntent.ExportImage -> exportImage(intent.format)
            EditorIntent.ExportVideo -> exportVideo()
            EditorIntent.ExportGif -> exportGif()

            EditorIntent.EnterLiquify -> enterLiquify()
            EditorIntent.ExitLiquify -> cancelLiquify()
            EditorIntent.ConfirmLiquify -> confirmLiquify()
            is EditorIntent.LiquifyStart -> liquifyStart(intent.point)
            is EditorIntent.LiquifyMove -> liquifyMove(intent.point)
            EditorIntent.LiquifyEnd -> liquifyEnd()
            is EditorIntent.SetLiquifyBrushRadius ->
                _state.update { it.copy(liquifyBrushRadius = intent.radius) }
            is EditorIntent.SetLiquifyBrushStrength ->
                _state.update { it.copy(liquifyBrushStrength = intent.strength) }
            EditorIntent.ResetLiquify -> resetLiquify()

            EditorIntent.ForceSave -> forceSaveNow()
            EditorIntent.DismissError -> _state.update { it.copy(errorMessage = null) }
        }
    }
    // endregion

    // region Drawing

    // ═══════════════════════════════════════════════
    //  绘制
    // ═══════════════════════════════════════════════

    private fun startStroke(intent: EditorIntent.StrokeStart) {
        if (!_state.value.canDraw) return
        val id = newId()
        liveStroke.clear()
        liveStroke.add(StrokePoint(
            x = intent.point.x, y = intent.point.y,
            pressure = intent.pressure,
            timestamp = System.nanoTime(),
        ))
        _state.update { it.copy(gestureMode = GestureMode.Drawing, liveStrokeId = id) }
    }

    private fun moveStroke(intent: EditorIntent.StrokeMove) {
        if (_state.value.gestureMode != GestureMode.Drawing) return
        liveStroke.add(StrokePoint(
            x = intent.point.x, y = intent.point.y,
            pressure = intent.pressure,
            timestamp = System.nanoTime(),
        ))
    }

    private fun endStroke() {
        val s = _state.value
        if (s.gestureMode != GestureMode.Drawing) return
        if (liveStroke.size < 2) {
            liveStroke.clear()
            _state.update { it.copy(gestureMode = GestureMode.Idle, liveStrokeId = null) }
            return
        }
        val stroke = VectorStroke(
            id = s.liveStrokeId ?: newId(),
            points = liveStroke.toList(),
            brush = s.brush,
        )
        liveStroke.clear()
        _state.update { it.copy(gestureMode = GestureMode.Idle, liveStrokeId = null) }
        applyCommand(AddElementCommand(
            frameIndex = s.currentFrameIndex,
            layerIndex = s.currentLayerIndex,
            element = stroke,
            label = "绘制",
        ))
    }

    private fun cancelStroke() {
        liveStroke.clear()
        _state.update { it.copy(gestureMode = GestureMode.Idle, liveStrokeId = null) }
    }
    // endregion

    // region ColorPicking

    // ═══════════════════════════════════════════════
    //  取色
    // ═══════════════════════════════════════════════

    private fun pickColor(point: Offset) {
        val s = _state.value
        val cs = s.project.canvasSize
        if (point.x < 0f || point.y < 0f || point.x >= cs.width || point.y >= cs.height) return

        viewModelScope.launch {
            val picked = withContext(Dispatchers.Default) {
                runCatching {
                    val bmp = BitmapCompositor.renderFrame(s.currentFrame, cs, s.project.background)
                        .asAndroidBitmap()
                    val x = point.x.toInt().coerceIn(0, cs.width - 1)
                    val y = point.y.toInt().coerceIn(0, cs.height - 1)
                    Color(bmp.getPixel(x, y))
                }.getOrNull()
            } ?: return@launch
            _state.update {
                it.copy(
                    brush = it.brush.withColor(picked),
                    activeTool = ActiveTool.Brush,
                    lastPickedColor = picked,
                )
            }
            // 1.6 秒后自动清空 lastPickedColor。cancel 旧 Job 重启计时。
            colorDismissJob?.cancel()
            colorDismissJob = viewModelScope.launch {
                delay(1600L)
                _state.update { it.copy(lastPickedColor = null) }
            }
        }
    }
    // endregion

    // region Selection

    // ═══════════════════════════════════════════════
    //  选区
    // ═══════════════════════════════════════════════

    private fun selectionTap(point: Offset) {
        if (_state.value.isFloating) return
        if (_state.value.gestureMode == GestureMode.Selecting) return

        val s = _state.value
        val cs = s.project.canvasSize
        if (point.x < 0f || point.y < 0f || point.x >= cs.width || point.y >= cs.height) return

        viewModelScope.launch {
            val sel = withContext(Dispatchers.Default) {
                runCatching {
                    val layerBmp = BitmapCompositor.renderLayer(s.currentLayer, cs).asAndroidBitmap()
                    Selection.magicWand(layerBmp, point, tolerance = 60)
                }.getOrNull()
            }

            if (sel == null) {
                Toast.makeText(getApplication(), "未选中内容", Toast.LENGTH_SHORT).show()
                return@launch
            }

            val total = cs.width.toLong() * cs.height
            val count = sel.pixelCount.toLong()
            val ratio = count.toDouble() / total

            // 触及画布 4 条边中的 3 条以上 → 视为误选整个画布
            val b = sel.bounds
            val edgesTouched = listOf(
                b.left == 0,
                b.top == 0,
                b.right >= cs.width,
                b.bottom >= cs.height,
            ).count { it }

            when {
                count < 16L -> {
                    Toast.makeText(getApplication(), "选区太小", Toast.LENGTH_SHORT).show()
                    return@launch
                }
                ratio > 0.85 || edgesTouched >= 3 -> {
                    Toast.makeText(
                        getApplication(),
                        "选区太大，请在内容区域点选",
                        Toast.LENGTH_SHORT,
                    ).show()
                    return@launch
                }
            }

            // 直接进入浮动 —— 跳过中间选区态
            enterFloating(sel)
        }
    }

    private fun selectionDraftStart(point: Offset) {
        if (_state.value.isFloating) return
        when (_state.value.selectTool) {
            SelectTool.Lasso -> {
                draftSelectionPath.clear()
                draftSelectionPath.add(point)
                _state.update { it.copy(gestureMode = GestureMode.Selecting) }
            }
            SelectTool.Rect, SelectTool.Ellipse -> _state.update {
                it.copy(draftStart = point, draftEnd = point, gestureMode = GestureMode.Selecting)
            }
            else -> {}
        }
    }

    private fun selectionDraftMove(point: Offset) {
        if (_state.value.gestureMode != GestureMode.Selecting) return
        when (_state.value.selectTool) {
            SelectTool.Lasso -> draftSelectionPath.add(point)
            SelectTool.Rect, SelectTool.Ellipse -> _state.update { it.copy(draftEnd = point) }
            else -> {}
        }
    }

    private fun selectionDraftEnd() {
        val s = _state.value
        val cs = s.project.canvasSize
        val sel: Selection? = when (s.selectTool) {
            SelectTool.Lasso -> Selection.lasso(draftSelectionPath.toList(), cs.width, cs.height)
            SelectTool.Rect -> {
                val a = s.draftStart
                val b = s.draftEnd
                if (a != null && b != null) Selection.rect(a.x, a.y, b.x, b.y, cs.width, cs.height)
                else null
            }
            SelectTool.Ellipse -> {
                val a = s.draftStart
                val b = s.draftEnd
                if (a != null && b != null) Selection.ellipse(a.x, a.y, b.x, b.y, cs.width, cs.height)
                else null
            }
            else -> null
        }
        draftSelectionPath.clear()
        _state.update {
            it.copy(
                draftStart = null,
                draftEnd = null,
                gestureMode = GestureMode.Idle,
            )
        }
        // 直接进入浮动 —— 跳过中间选区态
        if (sel != null) {
            viewModelScope.launch { enterFloating(sel) }
        }
    }

    fun startFloatingFromSelection() {
        val s = _state.value
        if (s.isFloating) return
        val sel = s.selection ?: return
        viewModelScope.launch { enterFloating(sel) }
    }

    private suspend fun enterFloating(sel: Selection) {
        val s = _state.value
        if (s.isFloating) return
        val frameIdx = s.currentFrameIndex
        val layerIdx = s.currentLayerIndex
        val layer = s.currentLayer
        val backup = layer.elements

        val result = withContext(Dispatchers.Default) {
            runCatching {
                val layerBmp = renderCache.getOrRenderLayer(layer, s.project.canvasSize).asAndroidBitmap()
                val cropped = SelectionOps.cropMasked(layerBmp, sel)
                val b = sel.bounds
                val w = (b.right - b.left).coerceAtLeast(1)
                val h = (b.bottom - b.top).coerceAtLeast(1)
                val sub = Bitmap.createBitmap(cropped, b.left, b.top, w, h)
                val erased = SelectionOps.eraseMask(layerBmp, sel)
                Triple(sub.asImageBitmap(), erased, b)
            }.getOrNull()
        } ?: return

        val (subImg, erasedBmp, bounds) = result

        val erasedElement = BitmapElement(
            id = newId(),
            image = erasedBmp.asImageBitmap(),
            label = "选区底图",
        )
        val newLayer = layer.copy(elements = listOf(erasedElement))
        val newLayers = s.currentFrame.layers.toMutableList().also { it[layerIdx] = newLayer }
        val newFrame = s.currentFrame.copy(layers = newLayers)
        val newProject = s.project.copy(
            frames = s.project.frames.toMutableList().also { it[frameIdx] = newFrame }
        )

        renderCache.invalidate()

        _state.update {
            it.copy(
                project = newProject,
                floatingSelection = FloatingSelection(
                    id = newId(),
                    image = subImg,
                    baseX = bounds.left.toFloat(),
                    baseY = bounds.top.toFloat(),
                    selection = sel,
                    backupElements = backup,
                    sourceFrameIndex = frameIdx,
                    sourceLayerIndex = layerIdx,
                ),
                activeTool = ActiveTool.Brush,
                selectedElementId = null,
            )
        }
    }

    private fun fillFloating() {
        val s = _state.value
        val fs = s.floatingSelection ?: return
        val color = s.brush.color
        viewModelScope.launch {
            val newImg = withContext(Dispatchers.Default) {
                runCatching {
                    val full = SelectionOps.fillMask(fs.selection, color.toArgb())
                    val b = fs.selection.bounds
                    Bitmap.createBitmap(full, b.left, b.top, b.width, b.height).asImageBitmap()
                }.getOrNull()
            } ?: return@launch
            _state.update {
                val cur = it.floatingSelection ?: return@update it
                it.copy(floatingSelection = cur.copy(image = newImg))
            }
        }
    }

    private fun clearFloating() {
        _state.update {
            val fs = it.floatingSelection ?: return@update it
            val blank = ImageBitmap(fs.image.width, fs.image.height)
            it.copy(floatingSelection = fs.copy(image = blank))
        }
    }

    private fun commitFloating() {
        val s = _state.value
        val fs = s.floatingSelection ?: return
        val frameIdx = fs.sourceFrameIndex
        val layerIdx = fs.sourceLayerIndex
        val layer = s.project.frames.getOrNull(frameIdx)?.layers?.getOrNull(layerIdx) ?: return

        viewModelScope.launch {
            val resultElement = withContext(Dispatchers.Default) {
                runCatching {
                    val currentBmp = BitmapCompositor.renderLayer(layer, s.project.canvasSize)
                        .asAndroidBitmap()
                    val composed = Bitmap.createBitmap(
                        currentBmp.width, currentBmp.height, Bitmap.Config.ARGB_8888
                    )
                    val canvas = Canvas(composed)
                    canvas.drawBitmap(currentBmp, 0f, 0f, null)

                    val floatBmp = fs.image.asAndroidBitmap()
                    val w = floatBmp.width.toFloat()
                    val h = floatBmp.height.toFloat()
                    canvas.save()
                    canvas.translate(fs.canvasLeft, fs.canvasTop)
                    if (fs.transform.rotation != 0f || fs.transform.scale != 1f) {
                        canvas.rotate(fs.transform.rotation, w / 2f, h / 2f)
                        canvas.scale(fs.transform.scale, fs.transform.scale, w / 2f, h / 2f)
                    }
                    canvas.drawBitmap(floatBmp, 0f, 0f, null)
                    canvas.restore()

                    BitmapElement(id = newId(), image = composed.asImageBitmap(), label = "选区内容")
                }.getOrNull()
            } ?: return@launch

            applyCommand(ReplaceLayerElementsCommand(
                frameIndex = frameIdx,
                layerIndex = layerIdx,
                oldElements = fs.backupElements,
                newElements = listOf(resultElement),
                label = "确定选区",
            ))

            _state.update {
                it.copy(
                    floatingSelection = null,
                    selection = null,
                    selectedElementId = null,  // 不选中整画布位图
                )
            }
            renderCache.invalidate()
        }
    }

    private fun cancelFloating() {
        val s = _state.value

        if (s.floatingSelection != null) {
            val fs = s.floatingSelection
            val frameIdx = fs.sourceFrameIndex
            val layerIdx = fs.sourceLayerIndex
            val frame = s.project.frames.getOrNull(frameIdx) ?: return
            val layer = frame.layers.getOrNull(layerIdx) ?: return

            val newLayer = layer.copy(elements = fs.backupElements)
            val newLayers = frame.layers.toMutableList().also { it[layerIdx] = newLayer }
            val newProject = s.project.copy(
                frames = s.project.frames.toMutableList().also {
                    it[frameIdx] = frame.copy(layers = newLayers)
                }
            )
            renderCache.invalidate()
            _state.update {
                it.copy(
                    project = newProject,
                    floatingSelection = null,
                    selection = null,
                    selectedElementId = null,
                    // 从选区来的浮动取消 → 回到 MagicWand，方便用户重新选
                    // 从图片导入来的浮动取消 → 回到 Brush
                    activeTool = if (fs.source == com.grillpoet.animy.domain.selection.FloatingSource.Selection)
                        ActiveTool.MagicWand else ActiveTool.Brush,
                )
            }
            return
        }

        // 选区态取消：只清选区，保持 MagicWand
        _state.update { it.copy(selection = null) }
    }

    /**
     * 只清空选区 —— 图层内容不变。
     * 用于「完成」按钮：用户选好了，退出选区模式继续画。
     */
    private fun clearSelectionOnly() {
        draftSelectionPath.clear()
        _state.update {
            it.copy(
                selection = null,
                draftStart = null,
                draftEnd = null,
            )
        }
    }

    private fun deleteSelection() {
        val s = _state.value
        if (s.floatingSelection != null) return

        val sel = s.selection ?: return
        val cs = s.project.canvasSize
        val frameIdx = s.currentFrameIndex
        val layerIdx = s.currentLayerIndex
        val layer = s.currentLayer

        viewModelScope.launch {
            val newElements = withContext(Dispatchers.Default) {
                runCatching {
                    val layerBmp = BitmapCompositor.renderLayer(layer, cs).asAndroidBitmap()
                    val erased = SelectionOps.eraseMask(layerBmp, sel)
                    listOf(BitmapElement(
                        id = newId(),
                        image = erased.asImageBitmap(),
                        label = "删除后",
                    ))
                }.getOrNull()
            } ?: return@launch

            applyCommand(ReplaceLayerElementsCommand(
                frameIndex = frameIdx,
                layerIndex = layerIdx,
                oldElements = layer.elements,
                newElements = newElements,
                label = "删除选区",
            ))
            _state.update { it.copy(selection = null) }
        }
    }
    // endregion

    // region Tools

    // ═══════════════════════════════════════════════
    //  工具
    // ═══════════════════════════════════════════════

    private fun setTool(tool: ActiveTool) {
        if (_state.value.activeTool == tool) return

        if (_state.value.isShapePending) {
            confirmShape()
        }

        if (tool == ActiveTool.Liquify) {
            enterLiquify()
            return
        }

        if (_state.value.liquifySession != null) {
            cancelLiquify()
        }

        draftSelectionPath.clear()
        _state.update {
            it.copy(
                activeTool = tool,
                draftStart = null,
                draftEnd = null,
                // 离开 MagicWand 时清空选区（选区和工具耦合）
                selection = if (tool != ActiveTool.MagicWand) null else it.selection,
            )
        }
    }

    private fun setSelectTool(tool: SelectTool) {
        _state.update { it.copy(selectTool = tool) }
    }

    private fun setBrushType(type: BrushType) {
        _state.update {
            it.copy(brush = it.brush.copy(type = type), activeTool = ActiveTool.Brush)
        }
    }

    private fun setColor(color: Color) {
        _state.update { it.copy(brush = it.brush.withColor(color)) }
    }

    private fun setBrushSize(size: Float) {
        _state.update { it.copy(brush = it.brush.withWidth(size)) }
    }

    // ═══════════════════════════════════════════════
    //  形状绘制
    // ═══════════════════════════════════════════════

    private fun shapeDraftStart(point: Offset) {
        if (_state.value.activeTool != ActiveTool.Shape) return
        if (_state.value.isFloating) return
        // 已有待确认形状：先落盘
        if (_state.value.isShapePending) {
            confirmShape()
        }
        _state.update {
            it.copy(
                draftShapeStart = point,
                draftShapeEnd = point,
                isShapePending = false,
            )
        }
    }

    private fun shapeDraftMove(point: Offset) {
        if (_state.value.draftShapeStart == null) return
        _state.update { it.copy(draftShapeEnd = point) }
    }

    private fun shapeDraftEnd() {
        val s = _state.value
        val start = s.draftShapeStart ?: return
        val end = s.draftShapeEnd ?: return

        val dx = end.x - start.x
        val dy = end.y - start.y
        if (dx * dx + dy * dy < 4f) {
            _state.update { it.copy(draftShapeStart = null, draftShapeEnd = null) }
            return
        }
        // 保留 draft，等待用户点确定/取消
        _state.update { it.copy(isShapePending = true) }
    }

    private fun confirmShape() {
        val s = _state.value
        val start = s.draftShapeStart ?: return
        val end = s.draftShapeEnd ?: return

        val element = ShapeElement(
            id = newId(),
            shapeType = s.shapeTool,
            start = start,
            end = end,
            brush = s.brush,
            filled = s.shapeFilled,
        )
        _state.update {
            it.copy(
                draftShapeStart = null,
                draftShapeEnd = null,
                isShapePending = false,
            )
        }
        applyCommand(AddElementCommand(
            frameIndex = s.currentFrameIndex,
            layerIndex = s.currentLayerIndex,
            element = element,
            label = s.shapeTool.displayName,
        ))
    }

    private fun cancelShape() {
        _state.update {
            it.copy(
                draftShapeStart = null,
                draftShapeEnd = null,
                isShapePending = false,
            )
        }
    }
    // endregion

    // region Liquify

    // ═══════════════════════════════════════════════
    //  液化
    // ═══════════════════════════════════════════════

    private fun enterLiquify() {
        val s = _state.value
        if (s.isFloating || s.isLiquifyActive) return
        val layer = s.currentLayer
        if (layer.isEmpty) {
            Toast.makeText(getApplication(), "当前图层为空", Toast.LENGTH_SHORT).show()
            return
        }
        val cs = s.project.canvasSize
        viewModelScope.launch {
            val result = withContext(Dispatchers.Default) {
                runCatching {
                    val raw = BitmapCompositor.renderLayerRaw(layer, cs).asAndroidBitmap()
                    val mutable = raw.copy(Bitmap.Config.ARGB_8888, true)
                    val w = mutable.width
                    val h = mutable.height
                    val pixels = IntArray(w * h)
                    mutable.getPixels(pixels, 0, w, 0, 0, w, h)
                    Triple(mutable, pixels, w to h)
                }.getOrNull()
            } ?: return@launch

            val (bmp, pixels, size) = result
            liquifyBitmap = bmp
            liquifyPixels = pixels

            _state.update {
                it.copy(
                    activeTool = ActiveTool.Liquify,
                    liquifySession = LiquifySession(
                        sourceFrameIndex = s.currentFrameIndex,
                        sourceLayerIndex = s.currentLayerIndex,
                        backupElements = layer.elements,
                        width = size.first,
                        height = size.second,
                    ),
                    liquifyPreview = bmp.asImageBitmap(),
                    selectedElementId = null,
                )
            }
        }
    }

    private fun liquifyStart(point: Offset) {
        if (_state.value.liquifySession == null) return
        liquifyLastPoint = point
    }

    private fun liquifyMove(point: Offset) {
        val s = _state.value
        val session = s.liquifySession ?: return
        val last = liquifyLastPoint ?: return
        val dx = point.x - last.x
        val dy = point.y - last.y
        if (dx == 0f && dy == 0f) return
        liquifyLastPoint = point

        val pixels = liquifyPixels ?: return
        val bmp = liquifyBitmap ?: return
        val w = session.width
        val h = session.height

        viewModelScope.launch {
            withContext(Dispatchers.Default) {
                LiquifyEngine.applyWarp(
                    pixels = pixels,
                    width = w,
                    height = h,
                    centerX = point.x,
                    centerY = point.y,
                    moveX = dx,
                    moveY = dy,
                    radius = s.liquifyBrushRadius,
                    strength = s.liquifyBrushStrength,
                )
                bmp.setPixels(pixels, 0, w, 0, 0, w, h)
            }
            _state.update { it.copy(liquifyPreview = bmp.asImageBitmap()) }
        }
    }

    private fun liquifyEnd() {
        liquifyLastPoint = null
    }

    private fun confirmLiquify() {
        val s = _state.value
        val session = s.liquifySession ?: return
        val bmp = liquifyBitmap ?: return

        val element = BitmapElement(
            id = newId(),
            image = bmp.asImageBitmap(),
            label = "液化",
        )

        applyCommand(ReplaceLayerElementsCommand(
            frameIndex = session.sourceFrameIndex,
            layerIndex = session.sourceLayerIndex,
            oldElements = session.backupElements,
            newElements = listOf(element),
            label = "液化",
        ))

        liquifyPixels = null
        liquifyBitmap = null
        liquifyLastPoint = null

        _state.update {
            it.copy(
                liquifySession = null,
                liquifyPreview = null,
                activeTool = ActiveTool.Brush,
            )
        }
        renderCache.invalidate()
    }

    private fun cancelLiquify() {
        liquifyPixels = null
        liquifyBitmap = null
        liquifyLastPoint = null
        _state.update {
            it.copy(
                liquifySession = null,
                liquifyPreview = null,
                activeTool = ActiveTool.Brush,
            )
        }
        renderCache.invalidate()
    }

    private fun resetLiquify() {
        val s = _state.value
        val session = s.liquifySession ?: return
        val layer = s.project.frames.getOrNull(session.sourceFrameIndex)
            ?.layers?.getOrNull(session.sourceLayerIndex) ?: return
        viewModelScope.launch {
            val result = withContext(Dispatchers.Default) {
                runCatching {
                    val raw = BitmapCompositor.renderLayerRaw(layer, s.project.canvasSize)
                        .asAndroidBitmap()
                    val mutable = raw.copy(Bitmap.Config.ARGB_8888, true)
                    val w = mutable.width
                    val h = mutable.height
                    val pixels = IntArray(w * h)
                    mutable.getPixels(pixels, 0, w, 0, 0, w, h)
                    Triple(mutable, pixels, w to h)
                }.getOrNull()
            } ?: return@launch
            val (bmp, pixels, _) = result
            liquifyBitmap = bmp
            liquifyPixels = pixels
            _state.update { it.copy(liquifyPreview = bmp.asImageBitmap()) }
        }
    }
    // endregion


    // region UndoRedo

    // ═══════════════════════════════════════════════
    //  撤销 / 重做
    // ═══════════════════════════════════════════════

    private fun undo() {
        val newProject = history.undo(_state.value.project) ?: return
        val label = history.lastUndoLabel
        _state.update {
            it.copy(
                project = newProject,
                canUndo = history.canUndo,
                canRedo = history.canRedo,
            )
        }
        renderCache.invalidate()
        scheduleSave()
        if (label != null) {
            Toast.makeText(getApplication(), "撤销：$label", Toast.LENGTH_SHORT).show()
        }
    }

    private fun redo() {
        val newProject = history.redo(_state.value.project) ?: return
        val label = history.lastRedoLabel
        _state.update {
            it.copy(
                project = newProject,
                canUndo = history.canUndo,
                canRedo = history.canRedo,
            )
        }
        renderCache.invalidate()
        scheduleSave()
        if (label != null) {
            Toast.makeText(getApplication(), "重做：$label", Toast.LENGTH_SHORT).show()
        }
    }
    // endregion

    // region Frames

    // ═══════════════════════════════════════════════
    //  帧
    // ═══════════════════════════════════════════════

    private fun selectFrame(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        if (index !in s.project.frames.indices) return
        draftSelectionPath.clear()
        _state.update {
            it.copy(
                currentFrameIndex = index,
                currentLayerIndex = it.currentLayerIndex.coerceAtMost(
                    s.project.frames[index].layers.lastIndex
                ),
                selectedElementId = null,
                draftStart = null,
                draftEnd = null,
                selection = null,
            )
        }
        renderCache.invalidate()
    }

    private fun addFrame() {
        if (_state.value.isFloating) return
        val at = _state.value.project.frames.size
        applyCommand(AddFrameCommand(Frame(), at = at))
        _state.update { it.copy(currentFrameIndex = at, currentLayerIndex = 0) }
        renderCache.invalidate()
    }

    private fun duplicateFrame(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        val idx = index.coerceIn(0, s.project.frames.lastIndex)
        val orig = s.project.frames.getOrNull(idx) ?: return
        val copy = orig.copy(
            id = newId(),
            layers = orig.layers.map { layer ->
                layer.copy(
                    id = newId(),
                    elements = layer.elements.map { it.withNewId() },
                )
            },
        )
        applyCommand(AddFrameCommand(copy, at = idx + 1))
        _state.update { it.copy(currentFrameIndex = idx + 1) }
        renderCache.invalidate()
    }

    private fun deleteFrame(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        if (s.project.frames.size <= 1) return
        val deleted = s.project.frames.getOrNull(index) ?: return
        applyCommand(DeleteFrameCommand(index, deleted))
        draftSelectionPath.clear()
        _state.update {
            it.copy(
                currentFrameIndex = it.currentFrameIndex.coerceAtMost(s.project.frames.size - 2),
                selection = null,
                selectedElementId = null,
                draftStart = null,
                draftEnd = null,
            )
        }
        renderCache.invalidate()
    }

    private fun moveFrame(from: Int, to: Int) {
        if (_state.value.isFloating) return
        if (from == to) return
        applyCommand(MoveFrameCommand(from, to))

        _state.update { st ->
            val cur = st.currentFrameIndex
            val newIdx = when {
                from == cur -> to
                from < cur && to >= cur -> cur - 1
                from > cur && to <= cur -> cur + 1
                else -> cur
            }
            st.copy(currentFrameIndex = newIdx)
        }
        renderCache.invalidate()
    }

    private fun setFrameDuration(index: Int, ms: Long) {
        val f = _state.value.project.frames.getOrNull(index) ?: return
        if (f.durationMs == ms) return
        applyCommand(SetFrameDurationCommand(index, f.durationMs, ms))
    }

    private fun nextFrame() {
        val s = _state.value
        if (s.project.frames.isEmpty()) return
        if (s.isFloating) return
        _state.update {
            it.copy(currentFrameIndex = (it.currentFrameIndex + 1) % it.project.frames.size)
        }
    }

    private fun togglePlay() {
        if (_state.value.isFloating) return
        _state.update { it.copy(isPlaying = !it.isPlaying) }
    }

    private fun toggleOnion() {
        _state.update { it.copy(onionSkin = it.onionSkin.copy(enabled = !it.onionSkin.enabled)) }
    }

    private fun toggleGrid() {
        _state.update { it.copy(showGrid = !it.showGrid) }
    }

    private fun setOnionConfig(prev: Int, next: Int) {
        _state.update {
            it.copy(onionSkin = it.onionSkin.copy(
                prev = prev.coerceIn(0, 5),
                next = next.coerceIn(0, 5),
            ))
        }
    }
    // endregion

    // region Layers

    // ═══════════════════════════════════════════════
    //  图层
    // ═══════════════════════════════════════════════

    private fun selectLayer(index: Int) {
        if (_state.value.isFloating) return
        _state.update { it.copy(currentLayerIndex = index.coerceAtLeast(0)) }
    }

    private fun addLayer(name: String = "") {
        if (_state.value.isFloating) return
        val s = _state.value
        val at = s.currentFrame.layers.size
        val newLayer = Layer(name = name.trim())
        applyCommand(AddLayerCommand(s.currentFrameIndex, newLayer, at))
        _state.update { it.copy(currentLayerIndex = at) }
    }

    private fun deleteLayer(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        if (s.currentFrame.layers.size <= 1) return
        val deleted = s.currentFrame.layers.getOrNull(index) ?: return
        applyCommand(DeleteLayerCommand(s.currentFrameIndex, index, deleted))
        _state.update {
            it.copy(currentLayerIndex = it.currentLayerIndex.coerceAtMost(
                it.currentFrame.layers.lastIndex.coerceAtLeast(0)
            ))
        }
    }

    private fun toggleLayerVisible(index: Int) {
        val s = _state.value
        val layer = s.currentFrame.layers.getOrNull(index) ?: return
        applyCommand(SetLayerVisibleCommand(s.currentFrameIndex, index, layer.visible))
    }

    private fun setLayerAlpha(index: Int, alpha: Float) {
        val s = _state.value
        val layer = s.currentFrame.layers.getOrNull(index) ?: return
        val a = alpha.coerceIn(0f, 1f)
        if (layer.alpha == a) return
        applyCommand(SetLayerAlphaCommand(s.currentFrameIndex, index, layer.alpha, a))
    }

    private fun renameLayer(index: Int, name: String) {
        val s = _state.value
        val layer = s.currentFrame.layers.getOrNull(index) ?: return
        if (layer.name == name) return
        applyCommand(RenameLayerCommand(s.currentFrameIndex, index, layer.name, name))
    }

    /** 上移一层（视觉向上 = real index +1） */
    private fun moveLayerUp(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        val to = (index + 1).coerceAtMost(s.currentFrame.layers.lastIndex)
        if (to != index) moveLayer(index, to)
    }

    /** 下移一层（视觉向下 = real index -1） */
    private fun moveLayerDown(index: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        val to = (index - 1).coerceAtLeast(0)
        if (to != index) moveLayer(index, to)
    }

    private fun moveLayer(from: Int, to: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        val size = s.currentFrame.layers.size
        if (from !in 0 until size || to !in 0 until size || from == to) return

        val prevCurrent = s.currentLayerIndex
        applyCommand(MoveLayerCommand(
            frameIndex = s.currentFrameIndex,
            from = from,
            to = to,
        ))

        // currentLayerIndex 跟随移动的图层
        val newCurrent = when {
            prevCurrent == from -> to
            from < prevCurrent && to >= prevCurrent -> prevCurrent - 1
            from > prevCurrent && to <= prevCurrent -> prevCurrent + 1
            else -> prevCurrent
        }
        _state.update { it.copy(currentLayerIndex = newCurrent) }
    }

    private fun mergeDown(layerIndex: Int) {
        if (_state.value.isFloating) return
        val s = _state.value
        if (layerIndex < 1 || layerIndex > s.currentFrame.layers.lastIndex) return

        val frameIdx = s.currentFrameIndex
        val frame = s.currentFrame
        val lower = frame.layers[layerIndex - 1]
        val upper = frame.layers[layerIndex]
        val canvasSize = s.project.canvasSize
        val oldFrame = frame

        viewModelScope.launch {
            val mergedElement = withContext(Dispatchers.Default) {
                runCatching {
                    val lowerBmp = BitmapCompositor
                        .renderLayerRaw(lower, canvasSize)
                        .asAndroidBitmap()
                    val upperBmp = BitmapCompositor
                        .renderLayerRaw(upper, canvasSize)
                        .asAndroidBitmap()

                    val combined = Bitmap.createBitmap(
                        canvasSize.width, canvasSize.height, Bitmap.Config.ARGB_8888
                    )
                    val canvas = Canvas(combined)
                    val lowerPaint = android.graphics.Paint().apply {
                        alpha = (lower.alpha.coerceIn(0f, 1f) * 255).toInt()
                    }
                    canvas.drawBitmap(lowerBmp, 0f, 0f, lowerPaint)
                    val upperPaint = android.graphics.Paint().apply {
                        alpha = (upper.alpha.coerceIn(0f, 1f) * 255).toInt()
                    }
                    canvas.drawBitmap(upperBmp, 0f, 0f, upperPaint)

                    BitmapElement(
                        id = newId(),
                        image = combined.asImageBitmap(),
                        label = "合并层",
                    )
                }.getOrNull()
            } ?: return@launch

            val capturedOldFrame = oldFrame
            applyCommand(object : EditCommand {
                override val label: String = "向下合并"
                override fun execute(project: Project): Project {
                    val f = project.frames.getOrNull(frameIdx) ?: return project
                    val list = f.layers.toMutableList()
                    val newUpper = list[layerIndex].copy(
                        name = list[layerIndex].name.ifBlank { "合并层" },
                        visible = true,
                        alpha = 1f,
                        elements = listOf(mergedElement),
                    )
                    list[layerIndex] = newUpper
                    list.removeAt(layerIndex - 1)
                    val newFrame = f.copy(layers = list)
                    return project.replaceFrame(frameIdx, newFrame)
                }
                override fun undo(project: Project): Project =
                    project.replaceFrame(frameIdx, capturedOldFrame)
            })

            _state.update {
                it.copy(currentLayerIndex = (layerIndex - 1).coerceAtLeast(0))
            }
        }
    }
    // endregion

    // region Elements

    // ═══════════════════════════════════════════════
    //  元素选择 / 变换
    // ═══════════════════════════════════════════════

    private fun selectElementAt(point: Offset) {
        if (_state.value.isFloating) return
        val s = _state.value
        val cs = s.project.canvasSize
        val maxArea = cs.width.toLong() * cs.height / 2

        // 只选面积 < 画布 50% 的位图元素 —— 排除 commit 生成的整画布位图
        val hitBmp = s.currentFrame.layers.asReversed().asSequence()
            .flatMap { it.elements.asReversed().asSequence() }
            .filterIsInstance<BitmapElement>()
            .filter { it.width.toLong() * it.height <= maxArea }
            .firstOrNull { it.hitTest(point, checkAlpha = true) }
        if (hitBmp != null) {
            _state.update { it.copy(selectedElementId = hitBmp.id) }
            return
        }
        val hitStroke = s.currentFrame.layers.asReversed().asSequence()
            .flatMap { it.elements.asReversed().asSequence() }
            .filterIsInstance<VectorStroke>()
            .firstOrNull { it.hitTest(point) }
        _state.update { it.copy(selectedElementId = hitStroke?.id) }
    }

    private fun deselectElement() {
        if (_state.value.isFloating) return
        _state.update { it.copy(selectedElementId = null) }
    }

    private fun transformStart(elementId: Long) {
        val s = _state.value
        if (s.isFloating) {
            _state.update { it.copy(gestureMode = GestureMode.Transforming) }
            return
        }
        val e = s.currentFrame.layers.asSequence()
            .flatMap { it.elements.asSequence() }
            .firstOrNull { it.id == elementId } ?: return
        transformElementId = elementId
        transformSnapshot = e.transform
        _state.update { it.copy(gestureMode = GestureMode.Transforming) }
    }

    private fun elementDragDelta(delta: Offset) {
        val s = _state.value
        if (s.isFloating) {
            _state.update {
                val fs = it.floatingSelection ?: return@update it
                it.copy(floatingSelection = fs.copy(
                    transform = fs.transform.copy(offset = fs.transform.offset + delta)
                ))
            }
            return
        }
        val id = s.selectedElementId ?: return
        if (s.gestureMode != GestureMode.Transforming) return
        val newLayers = s.currentFrame.layers.map { l ->
            l.copy(elements = l.elements.map { e ->
                if (e.id != id) e
                else {
                    val nt = e.transform.copy(offset = e.transform.offset + delta)
                    when (e) {
                        is VectorStroke -> e.copy(transform = nt)
                        is BitmapElement -> e.copy(transform = nt)
                        is com.grillpoet.animy.domain.model.ShapeElement -> e.copy(transform = nt)
                    }
                }
            })
        }
        val newProject = s.project.copy(
            frames = s.project.frames.toMutableList().also {
                it[s.currentFrameIndex] = s.currentFrame.copy(layers = newLayers)
            }
        )
        _state.update { it.copy(project = newProject) }
    }

    private fun elementTransformDelta(intent: EditorIntent.ElementTransformDelta) {
        val s = _state.value
        if (s.isFloating) {
            _state.update {
                val fs = it.floatingSelection ?: return@update it
                val t = fs.transform
                it.copy(floatingSelection = fs.copy(
                    transform = ElementTransform(
                        offset = t.offset + intent.pan,
                        scale = (t.scale * intent.zoom).coerceIn(0.05f, 20f),
                        rotation = t.rotation + intent.rotation,
                    )
                ))
            }
            return
        }
        val id = s.selectedElementId ?: return
        if (s.gestureMode != GestureMode.Transforming) return
        val newLayers = s.currentFrame.layers.map { l ->
            l.copy(elements = l.elements.map { e ->
                if (e.id != id) e
                else {
                    val t = e.transform
                    val nt = ElementTransform(
                        offset = t.offset + intent.pan,
                        scale = (t.scale * intent.zoom).coerceIn(0.05f, 20f),
                        rotation = t.rotation + intent.rotation,
                    )
                    when (e) {
                        is VectorStroke -> e.copy(transform = nt)
                        is BitmapElement -> e.copy(transform = nt)
                        is com.grillpoet.animy.domain.model.ShapeElement -> e.copy(transform = nt)
                    }
                }
            })
        }
        val newProject = s.project.copy(
            frames = s.project.frames.toMutableList().also {
                it[s.currentFrameIndex] = s.currentFrame.copy(layers = newLayers)
            }
        )
        _state.update { it.copy(project = newProject) }
    }

    private fun transformEnd() {
        val s = _state.value
        if (s.isFloating) {
            _state.update { it.copy(gestureMode = GestureMode.Idle) }
            return
        }
        val before = transformSnapshot ?: run {
            _state.update { it.copy(gestureMode = GestureMode.Idle) }
            return
        }
        val id = transformElementId ?: run {
            _state.update { it.copy(gestureMode = GestureMode.Idle) }
            return
        }
        transformSnapshot = null
        transformElementId = null
        _state.update { it.copy(gestureMode = GestureMode.Idle) }

        val e = s.currentFrame.layers.asSequence()
            .flatMap { it.elements.asSequence() }
            .firstOrNull { it.id == id } ?: return
        if (e.transform == before) return

        history.record(TransformElementCommand(
            frameIndex = s.currentFrameIndex,
            elementId = id,
            before = before,
            after = e.transform,
        ))
        _state.update { it.copy(canUndo = history.canUndo, canRedo = history.canRedo) }
        scheduleSave()
    }
    // endregion

    // region ProjectSettings

    // ═══════════════════════════════════════════════
    //  项目设置
    // ═══════════════════════════════════════════════

    private fun setBackground(color: Color) {
        if (_state.value.isFloating) return
        val s = _state.value
        if (s.project.background == color) return
        applyCommand(SetBackgroundCommand(s.project.background, color))
    }

    private fun importImage(uri: Uri) {
        if (_state.value.isFloating) return
        val app = getApplication<Application>()
        val s = _state.value
        val cs = s.project.canvasSize
        val frameIdx = s.currentFrameIndex
        val layerIdx = s.currentLayerIndex
        val layer = s.currentLayer
        val backup = layer.elements

        viewModelScope.launch {
            val scaled = withContext(Dispatchers.IO) {
                runCatching {
                    val input = app.contentResolver.openInputStream(uri) ?: return@runCatching null
                    val bmp = android.graphics.BitmapFactory.decodeStream(input)
                    input.close()
                    if (bmp == null) null else {
                        val maxW = cs.width * 0.8f
                        val maxH = cs.height * 0.8f
                        val k = minOf(maxW / bmp.width, maxH / bmp.height, 1f)
                        val nw = (bmp.width * k).toInt().coerceAtLeast(1)
                        val nh = (bmp.height * k).toInt().coerceAtLeast(1)
                        Bitmap.createScaledBitmap(bmp, nw, nh, true)
                    }
                }.getOrNull()
            }

            if (scaled == null) {
                Toast.makeText(app, "图片导入失败", Toast.LENGTH_SHORT).show()
                return@launch
            }

            val emptySel = Selection(
                mask = BooleanArray(cs.width * cs.height),
                width = cs.width,
                height = cs.height,
            )

            val baseX = (cs.width - scaled.width) / 2f
            val baseY = (cs.height - scaled.height) / 2f

            _state.update {
                it.copy(
                    floatingSelection = FloatingSelection(
                        id = newId(),
                        image = scaled.asImageBitmap(),
                        baseX = baseX,
                        baseY = baseY,
                        selection = emptySel,
                        backupElements = backup,
                        sourceFrameIndex = frameIdx,
                        sourceLayerIndex = layerIdx,
                        source = FloatingSource.ImageImport,
                    ),
                    activeTool = ActiveTool.Brush,
                    selectedElementId = null,
                )
            }
        }
    }
    // endregion

    // region Export

    // ═══════════════════════════════════════════════
    //  导出
    // ═══════════════════════════════════════════════

    private fun exportImage(format: ImageFormat) {
        val s = _state.value
        _state.update { it.copy(isExporting = true, exportingLabel = "导出图片中…") }
        viewModelScope.launch {
            val result = ImageExporter.export(
                context = getApplication(),
                frame = s.currentFrame,
                format = format,
                size = s.project.canvasSize,
                background = s.project.background,
            )
            _state.update { it.copy(isExporting = false, exportingLabel = null) }
            val msg = when (result) {
                is ImageExportResult.Success -> "已保存到 Pictures/animy"
                is ImageExportResult.Failure -> "导出失败：${result.reason}"
            }
            Toast.makeText(getApplication(), msg, Toast.LENGTH_SHORT).show()
        }
    }

    private fun exportVideo() {
        val s = _state.value
        if (s.isExporting) return
        _state.update { it.copy(isExporting = true, exportProgress = 0f, exportingLabel = "导出视频中…") }

        val frames = s.project.frames.toList()
        val bg = s.project.background
        val cs = s.project.canvasSize
        val name = s.project.name.ifBlank { "animy" } + "_" + System.currentTimeMillis()

        viewModelScope.launch {
            val result = VideoExporter.export(
                context = getApplication(),
                frames = frames,
                size = cs,
                background = bg,
                name = name,
                onProgress = { done, total ->
                    if (total > 0) _state.update {
                        it.copy(exportProgress = done.toFloat() / total)
                    }
                },
            )
            _state.update { it.copy(isExporting = false, exportProgress = 0f, exportingLabel = null) }
            val msg = when (result) {
                is VideoExportResult.Success -> "已保存到 Movies/animy"
                is VideoExportResult.Failure -> "导出失败：${result.reason}"
            }
            Toast.makeText(getApplication(), msg, Toast.LENGTH_SHORT).show()
        }
    }

    private fun exportGif() {
        val s = _state.value
        if (s.isExporting) return
        _state.update { it.copy(isExporting = true, exportProgress = 0f, exportingLabel = "导出 GIF 中…") }

        val frames = s.project.frames.toList()
        val bg = s.project.background
        val cs = s.project.canvasSize
        val name = s.project.name.ifBlank { "animy" } + "_" + System.currentTimeMillis()

        viewModelScope.launch {
            val result = GifExporter.export(
                context = getApplication(),
                frames = frames,
                size = cs,
                background = bg,
                name = name,
                onProgress = { done, total ->
                    if (total > 0) _state.update {
                        it.copy(exportProgress = done.toFloat() / total)
                    }
                },
            )
            _state.update { it.copy(isExporting = false, exportProgress = 0f, exportingLabel = null) }
            val msg = when (result) {
                is GifExportResult.Success -> "GIF 已保存到 Pictures/animy"
                is GifExportResult.Failure -> "导出失败：${result.reason}"
            }
            Toast.makeText(getApplication(), msg, Toast.LENGTH_SHORT).show()
        }
    }
    // endregion

    // region Save

    // ═══════════════════════════════════════════════
    //  保存
    // ═══════════════════════════════════════════════

    fun forceSaveNow() {
        saveJob?.cancel()
        val project = _state.value.project
        val id = projectId
        viewModelScope.launch {
            runCatching { repository.save(project, id) }
        }
    }

    suspend fun saveNow() {
        saveJob?.cancel()
        runCatching { repository.save(_state.value.project, projectId) }
    }

    private fun scheduleSave() {
        saveJob?.cancel()
        saveJob = viewModelScope.launch {
            delay(SAVE_DEBOUNCE_MS)
            runCatching { repository.save(_state.value.project, projectId) }
        }
    }
    // endregion

    // region Internal

    // ═══════════════════════════════════════════════
    //  命令
    // ═══════════════════════════════════════════════

    private fun applyCommand(cmd: EditCommand) {
        val newProject = cmd.execute(_state.value.project)
        history.record(cmd)
        _state.update {
            it.copy(
                project = newProject,
                canUndo = history.canUndo,
                canRedo = history.canRedo,
            )
        }
        renderCache.invalidate()
        scheduleSave()
    }

    // endregion

    companion object {
        fun factory(projectId: String) = viewModelFactory {
            initializer {
                val app = this[ViewModelProvider.AndroidViewModelFactory.APPLICATION_KEY]!!
                EditorViewModel(app, projectId)
            }
        }
    }
}
