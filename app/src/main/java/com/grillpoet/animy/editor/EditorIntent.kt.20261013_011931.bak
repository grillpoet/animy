package com.grillpoet.animy.editor

import android.net.Uri
import androidx.compose.ui.geometry.Offset
import androidx.compose.ui.graphics.Color
import com.grillpoet.animy.data.export.ImageFormat
import com.grillpoet.animy.domain.model.BrushType

sealed interface EditorIntent {

    // 绘制
    data class StrokeStart(val point: Offset, val pressure: Float = 1f) : EditorIntent
    data class StrokeMove(val point: Offset, val pressure: Float = 1f) : EditorIntent
    data object StrokeEnd : EditorIntent
    data object StrokeCancel : EditorIntent

    // 取色
    data class PickColor(val point: Offset) : EditorIntent
    data object DismissPickedColor : EditorIntent

    // 选区
    data class SelectionTap(val point: Offset) : EditorIntent
    data class SelectionDraftStart(val point: Offset) : EditorIntent
    data class SelectionDraftMove(val point: Offset) : EditorIntent
    data object SelectionDraftEnd : EditorIntent
    data object SelectionCommit : EditorIntent
    data object SelectionFill : EditorIntent
    data object SelectionDelete : EditorIntent
    data object SelectionClear : EditorIntent
    data object SelectionCancel : EditorIntent

    // 工具
    data class SetTool(val tool: ActiveTool) : EditorIntent
    data class SetSelectTool(val tool: SelectTool) : EditorIntent
    data class SetBrushType(val type: BrushType) : EditorIntent
    data class SetColor(val color: Color) : EditorIntent
    data class SetBrushSize(val size: Float) : EditorIntent

    // 撤销 / 重做
    data object Undo : EditorIntent
    data object Redo : EditorIntent

    // 帧
    data class SelectFrame(val index: Int) : EditorIntent
    data object AddFrame : EditorIntent
    data class DuplicateFrame(val index: Int) : EditorIntent
    data class DeleteFrame(val index: Int) : EditorIntent
    data class MoveFrame(val from: Int, val to: Int) : EditorIntent
    data class SetFrameDuration(val index: Int, val ms: Long) : EditorIntent
    data object NextFrame : EditorIntent
    data object TogglePlay : EditorIntent
    data object ToggleOnion : EditorIntent
    data class SetOnionConfig(val prev: Int, val next: Int) : EditorIntent

    // 视图
    data object ToggleGrid : EditorIntent

    // 图层
    data class SelectLayer(val index: Int) : EditorIntent
    data class AddLayer(val name: String = "") : EditorIntent
    data class DeleteLayer(val index: Int) : EditorIntent
    data class ToggleLayerVisible(val index: Int) : EditorIntent
    data class SetLayerAlpha(val index: Int, val alpha: Float) : EditorIntent
    data class RenameLayer(val index: Int, val name: String) : EditorIntent
    data class MergeDown(val layerIndex: Int) : EditorIntent
    data class MoveLayer(val from: Int, val to: Int) : EditorIntent
    data class MoveLayerUp(val index: Int) : EditorIntent
    data class MoveLayerDown(val index: Int) : EditorIntent

    // 元素 / 浮动变换
    data class SelectElementAt(val point: Offset) : EditorIntent
    data object DeselectElement : EditorIntent
    data class TransformStart(val elementId: Long) : EditorIntent
    data class ElementDragDelta(val delta: Offset) : EditorIntent
    data class ElementTransformDelta(
        val zoom: Float,
        val rotation: Float,
        val pan: Offset,
    ) : EditorIntent
    data object TransformEnd : EditorIntent

    // 项目
    data class SetBackground(val color: Color) : EditorIntent
    data class ImportImage(val uri: Uri) : EditorIntent

    // 导出
    data class ExportImage(val format: ImageFormat) : EditorIntent
    data object ExportVideo : EditorIntent
    data object ExportGif : EditorIntent

    // 液化
    data object EnterLiquify : EditorIntent
    data object ExitLiquify : EditorIntent
    data object ConfirmLiquify : EditorIntent
    data class LiquifyStart(val point: Offset) : EditorIntent
    data class LiquifyMove(val point: Offset) : EditorIntent
    data object LiquifyEnd : EditorIntent
    data class SetLiquifyBrushRadius(val radius: Float) : EditorIntent
    data class SetLiquifyBrushStrength(val strength: Float) : EditorIntent
    data object ResetLiquify : EditorIntent

    // 生命周期
    data object ForceSave : EditorIntent
    data object DismissError : EditorIntent
}
